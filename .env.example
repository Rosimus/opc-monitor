# Database
POSTGRES_USER=opc_user
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=opc_monitor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (для Gmail нужно создать App Password)
EMAIL_PASSWORD=your_app_password_here

# Admin credentials
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_secure_admin_password

# JWT Secret (сгенерируйте случайную строку)
JWT_SECRET_KEY=your_jwt_secret_here_change_me

# OPC
OPC_URL=opc.tcp://server:4840

# Environment
ENV=production
DEBUG=False

# Grafana
GRAFANA_PASSWORD=admin
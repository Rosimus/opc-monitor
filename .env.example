# Database
POSTGRES_USER=opc_user
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=opc_monitor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL=30

# Email (для Gmail нужно создать App Password)
EMAIL_PASSWORD=your_app_password_here

# Admin credentials
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_secure_admin_password

# JWT Secret (сгенерируйте случайную строку)
JWT_SECRET_KEY=your_jwt_secret_here_change_me

# ============================================
# OPC UA
# ============================================
# URL, по которому клиент подключается к серверу внутри docker-сети:
OPC_URL=opc.tcp://server:4840

# URL, который OPC UA-сервер анонсирует клиентам в GetEndpoints.
# Должен резолвиться со стороны client. Для docker-compose — то же значение.
OPC_ADVERTISE_URL=opc.tcp://server:4840

# Режим безопасности OPC UA:
#   None           — без шифрования (dev, тесты). ⚠️ НЕ для прода
#   Sign           — подпись без шифрования
#   SignAndEncrypt — подпись + шифрование (рекомендовано для prod)
OPC_SECURITY_MODE=None

# Учётные данные OPC UA-сессии. Обязательны при OPC_SECURITY_MODE=Sign*
OPC_USER=operator
OPC_PASSWORD=change_me_opc_password

# Environment
ENV=production
DEBUG=False

# Grafana
GRAFANA_PASSWORD=admin

# Telegram для Alertmanager (опционально)
# Если пусто — Alertmanager будет логировать алерты, но не отправлять в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
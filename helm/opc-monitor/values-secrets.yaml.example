# Скопируйте этот файл в values-secrets.yaml и замените значения на реальные.
# НЕ КОММИТЬТЕ values-secrets.yaml в Git — он уже в .gitignore.
secrets:
  postgresUser: opc_user
  postgresPassword: "<your-postgres-password>"
  postgresDb: opc_monitor
  adminUser: admin
  adminPassword: "<your-admin-password>"
  # Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
  jwtSecretKey: "<64-char-hex>"
  emailPassword: ""
  grafanaPassword: "<your-grafana-password>"

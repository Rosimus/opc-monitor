# ============================================================
# Helm values для секретов
# ============================================================
#
# ИНСТРУКЦИЯ:
#   1. Скопируйте этот файл в values-secrets.yaml
#   2. Замените placeholder'ы на реальные значения
#   3. Передайте при деплое: helm install ... -f values-secrets.yaml
#
# ВАЖНО:
#   - values-secrets.yaml добавлен в .gitignore и НЕ коммитится
#   - Не храните реальные секреты в values.yaml или values-prod.yaml
#   - В продакшене используйте External Secrets Operator, SOPS или Vault
#
# ============================================================

secrets:
  # PostgreSQL
  postgresUser: opc_user
  postgresPassword: REPLACE_WITH_STRONG_PASSWORD
  postgresDb: opc_monitor

  # JWT для аутентификации API
  # Сгенерировать: openssl rand -hex 32
  jwtSecretKey: REPLACE_WITH_RANDOM_64_CHARS

  # Admin credentials для входа в веб-интерфейс
  adminUser: admin
  adminPassword: REPLACE_WITH_STRONG_ADMIN_PASSWORD

  # Grafana
  grafanaPassword: REPLACE_WITH_STRONG_GRAFANA_PASSWORD

  # Email (для алертов)
  emailPassword: REPLACE_WITH_GMAIL_APP_PASSWORD

  # Telegram (для Alertmanager)
  # Если не используете — оставьте placeholder
  telegramBotToken: "placeholder"
  telegramChatId: "0"
# ============================================================
# Шаблон для секретов OPC UA. Скопируйте в certs-secrets.yaml
# (файл в .gitignore) и заполните base64-encoded сертификатами.
#
# Генерация сертификатов:
#     python certs/generate.py
#
# Кодирование в base64:
#     Linux/macOS:
#         base64 -w0 certs/ca_cert.pem
#         base64 -w0 certs/server_cert.pem
#         base64 -w0 certs/server_key.pem
#         base64 -w0 certs/client_cert.pem
#         base64 -w0 certs/client_key.pem
#
#     Windows PowerShell:
#         [Convert]::ToBase64String([IO.File]::ReadAllBytes("certs\ca_cert.pem"))
#         [Convert]::ToBase64String([IO.File]::ReadAllBytes("certs\server_cert.pem"))
#         [Convert]::ToBase64String([IO.File]::ReadAllBytes("certs\server_key.pem"))
#         [Convert]::ToBase64String([IO.File]::ReadAllBytes("certs\client_cert.pem"))
#         [Convert]::ToBase64String([IO.File]::ReadAllBytes("certs\client_key.pem"))
#
# Установка:
#     helm upgrade --install opc-monitor ./helm/opc-monitor \
#         -n opc-monitor \
#         -f helm/opc-monitor/values-prod.yaml \
#         -f helm/opc-monitor/values-secrets.yaml \
#         -f helm/opc-monitor/certs-secrets.yaml

certs:
  caCert: ""
  serverCert: ""
  serverKey: ""
  clientCert: ""
  clientKey: ""